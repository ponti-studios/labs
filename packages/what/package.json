{
  "name": "what",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "predev": "tsx scripts/generate-manifest.ts",
    "dev:app": "react-router dev",
    "build": "tsx scripts/generate-manifest.ts && react-router build",
    "start": "react-router-serve build/server/index.js",
    "lint": "oxlint src --fix",
    "lint:check": "oxlint src",
    "format": "oxfmt src --write",
    "test": "vitest run --config vitest.config.ts",
    "size": "vite build --config vite.size.config.ts && node scripts/record-size.mjs",
    "game:health-check": "tsx scripts/game-health-check.ts",
    "game:ingest": "tsx scripts/game-ingest.ts",
    "game:preview": "tsx scripts/game-preview.ts",
    "game:prompt-test": "tsx scripts/game-prompt-test.ts",
    "game:capture-fixtures": "tsx scripts/game-capture-fixtures.ts",
    "game:generate": "tsx scripts/game-generate.ts",
    "game:seed": "tsx scripts/game-seed.ts",
    "game:gallery:screenshot": "tsx scripts/game-gallery.ts --mode screenshot",
    "game:gallery:solve": "tsx scripts/game-gallery.ts --mode solve",
    "game:tile-states": "tsx scripts/game-tile-states.ts",
    "game:e2e": "tsx scripts/game-e2e.ts",
    "storybook": "storybook dev -p 6008",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@mozilla/readability": "catalog:",
    "@ponti-studios/auth": "catalog:",
    "@ponti-studios/ui": "catalog:",
    "@pontistudios/ai": "workspace:*",
    "@pontistudios/db": "workspace:*",
    "@pontistudios/env": "workspace:*",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "cn": "^0.2.6",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsx": "^4.23.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  },
  "portless": {
    "name": "what",
    "script": "dev:app"
  }
}
