{
  "name": "what",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview",
    "size": "vite build --config vite.size.config.ts && node scripts/record-size.mjs",
    "what:health-check": "tsx scripts/what-health-check.ts",
    "what:ingest": "tsx scripts/what-ingest.ts",
    "what:preview": "tsx scripts/what-preview.ts",
    "what:prompt-test": "tsx scripts/what-prompt-test.ts",
    "what:capture-fixtures": "tsx scripts/what-capture-fixtures.ts",
    "what:generate": "tsx scripts/what-generate.ts",
    "what:seed-history": "tsx scripts/what-seed-history.ts",
    "what:seed-dev": "tsx scripts/what-seed-dev.ts",
    "what:gallery:screenshot": "tsx scripts/what-gallery.ts --mode screenshot",
    "what:gallery:solve": "tsx scripts/what-gallery.ts --mode solve",
    "what:tile-states": "tsx scripts/what-tile-states.ts",
    "what:e2e": "tsx scripts/what-e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@pontistudios/ai": "workspace:*",
    "@ponti-studios/auth": "^0.2.0",
