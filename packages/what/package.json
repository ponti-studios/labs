    "@pontistudios/db": "workspace:*",
    "@pontistudios/env": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^30.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "preact": "^10.24.3",
    "react-router": "^8.2.0",
    "tsx": "^4.23.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^24.13.3",
    "@types/jsdom": "^21.1.7",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
