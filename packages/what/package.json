{
  "name": "what",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve build/server/index.js",
    "lint": "oxlint src --fix",
    "lint:check": "oxlint src",
    "format": "oxfmt src --write",
    "test": "vitest run --config vitest.config.ts",
    "size": "vite build --config vite.size.config.ts && node scripts/record-size.mjs",
    "game:health-check": "tsx scripts/game-health-check.ts",
    "game:ingest": "tsx scripts/game-ingest.ts",
    "game:preview": "tsx scripts/game-preview.ts",
    "game:prompt-test": "tsx scripts/game-prompt-test.ts",
    "game:capture-fixtures": "tsx scripts/game-capture-fixtures.ts",
    "game:generate": "tsx scripts/game-generate.ts",
    "game:seed-history": "tsx scripts/game-seed-history.ts",
    "game:seed-dev": "tsx scripts/game-seed-dev.ts",
    "game:gallery:screenshot": "tsx scripts/game-gallery.ts --mode screenshot",
    "game:gallery:solve": "tsx scripts/game-gallery.ts --mode solve",
    "game:tile-states": "tsx scripts/game-tile-states.ts",
    "game:e2e": "tsx scripts/game-e2e.ts",
    "storybook": "storybook dev -p 6008",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@ponti-studios/auth": "^0.2.0",
    "@ponti-studios/ui": "1.5.1",
    "@pontistudios/ai": "workspace:*",
    "@pontistudios/db": "workspace:*",
    "@pontistudios/env": "workspace:*",
    "@react-router/node": "^8.2.0",
    "@react-router/serve": "^8.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.31.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "tsx": "^4.23.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8.2.0",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/react-vite": "^10.5.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.77.0",
    "playwright": "^1.61.1",
    "storybook": "^10.5.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
