{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/what/Dockerfile",
    "watchPatterns": ["**"]
  },
  "deploy": {
    "startCommand": "./node_modules/.bin/tsx src/server/index.ts",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
