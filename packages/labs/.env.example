# Database Configuration
# Clone and run foundation first:
#   git clone https://github.com/ponti-studios/foundation.git ../foundation
#   cd ../foundation && just docker-up
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hominem
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:4433/hominem-test

# Redis
REDIS_URL=redis://localhost:6379

# S3 / R2 Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=labyrinth
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000

# AI
OPENROUTER_API_KEY=sk-or-your-key-here

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Application
NODE_ENV=development
LOG_LEVEL=info

# Hominem API (hosted login + session). Under portless each app gets a stable
# https://<name>.lvh.me:4200 URL; the proxy runs at
# `pnpm exec portless proxy start --port 4200 --tld lvh.me`.
HOMINEM_API_URL=https://api.lvh.me:4200
HOMINEM_INTERNAL_API_URL=https://api.lvh.me:4200

# Standalone What app URL used by legacy redirects and browser links.
# Served by portless at https://what.lvh.me:4200.
WHAT_APP_URL=https://what.lvh.me:4200
VITE_WHAT_APP_URL=https://what.lvh.me:4200

# Sentry (optional; the public DSN is safe to expose to the browser)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
# Required only for source-map uploads during production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
