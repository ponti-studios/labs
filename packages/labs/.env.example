# Database Configuration
# Clone and run foundation first:
#   git clone https://github.com/ponti-studios/foundation.git ../foundation
#   cd ../foundation && just docker-up
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hominem
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:4433/hominem-test

# Redis
REDIS_URL=redis://localhost:6379

# S3 / R2 Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=labyrinth
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000

# AI
OPENROUTER_API_KEY=sk-or-your-key-here

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google
VITE_GOOGLE_API_KEY=

# Application
NODE_ENV=development
LOG_LEVEL=info

# Game admin (required in production; local `pnpm dev` skips this gate)
ADMIN_SECRET=dev-admin-secret
# GAME_ADMIN_EMAILS=you@ponti.io

# Origin of the standalone game app, for CORS on the API routes it calls
# directly from the browser (see app/lib/server/game-cors.ts)
# GAME_APP_ORIGIN=https://game.ponti.io

# Sentry (optional; the public DSN is safe to expose to the browser)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
# Required only for source-map uploads during production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
