{
  "name": "@pontistudios/labyrinth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "portless",
    "dev:app": "react-router dev",
    "lint": "oxlint app --fix",
    "lint:check": "oxlint app",
    "format": "oxfmt app --write",
    "search:seed": "JITI_TSCONFIG_PATHS=1 jiti scripts/load-search-corpus.ts",
    "search:sync": "JITI_TSCONFIG_PATHS=1 jiti scripts/load-search-corpus.ts --mode sync",
    "connections:simulate": "JITI_TSCONFIG_PATHS=1 jiti scripts/connections/simulate.ts",
    "start": "react-router-serve ./build/server/index.js --port=${PORT:-3000}",
    "test": "DEBUG_PRINT_LIMIT=500 vitest run --environment jsdom --coverage --reporter verbose --passWithNoTests",
    "storybook": "storybook dev -p 6007",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@mozilla/readability": "catalog:",
    "@openrouter/sdk": "catalog:",
    "@ponti-studios/auth": "catalog:",
    "@ponti-studios/ui": "catalog:",
    "@pontistudios/ai": "workspace:*",
    "@pontistudios/db": "workspace:*",
    "@pontistudios/env": "workspace:*",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@sentry/node": "^10.71.0",
    "@sentry/react-router": "^10.70.0",
    "@tanstack/react-query": "^5.101.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "catalog:",
    "framer-motion": "13.2.0",
    "isbot": "^5.2.2",
    "iso-3166-1": "^2.1.1",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.5",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^4.1.11",
    "jiti": "^2.7.0",
    "oxfmt": "0.67.0",
    "oxlint": "catalog:",
    "pg": "^8.23.0",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "portless": {
    "name": "labyrinth",
    "script": "dev:app"
  }
}
