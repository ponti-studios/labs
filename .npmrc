engine-strict=true
legacy-peer-deps=true
shamefully-hoist=false
strict-peer-dependencies=true
confirm-modules-purge=false
pnpm.onlyBuiltDependencies[]=@openrouter/sdk
pnpm.onlyBuiltDependencies[]=bufferutil
pnpm.onlyBuiltDependencies[]=esbuild
pnpm.onlyBuiltDependencies[]=msw
auto-install-peers=false
resolve-peers-from-workspace-root=false
# @ponti-studios/* is published to GitHub Packages, which requires a token
# even for public packages. The credential deliberately does NOT live here —
# pnpm refuses to expand env vars in a committed .npmrc, since that file
# could leak the secret to an attacker-controlled registry. Put it in your
# user-level ~/.npmrc instead:
#   //npm.pkg.github.com/:_authToken=<PAT with read:packages>
# CI writes the same line using the workflow's own GITHUB_TOKEN.
@ponti-studios:registry=https://npm.pkg.github.com
