{
  "name": "labs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "check": "pnpm run lint:check && pnpm run typecheck",
    "dev": "portless",
    "dev:app": "react-router dev",
    "lint": "oxlint app --fix",
    "lint:check": "oxlint app",
    "format": "oxfmt app --write",
    "search:seed": "JITI_TSCONFIG_PATHS=1 jiti scripts/load-search-corpus.ts",
    "search:sync": "JITI_TSCONFIG_PATHS=1 jiti scripts/load-search-corpus.ts --mode sync",
    "connections:simulate": "JITI_TSCONFIG_PATHS=1 jiti scripts/connections/simulate.ts",
    "start": "react-router-serve ./build/server/index.js --port=${PORT:-3000}",
    "test": "DEBUG_PRINT_LIMIT=500 vitest run --environment jsdom --coverage --reporter verbose --passWithNoTests",
    "storybook": "storybook dev -p 6007",
    "typecheck": "react-router typegen && tsc -b",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/sdk": "^1.3.27",
    "@ponti-studios/auth": "^0.2.0",
    "@ponti-studios/ui": "1.8.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.2.0",
    "@sentry/node": "^10.71.0",
    "@sentry/react-router": "^10.74.0",
    "@tanstack/react-query": "^5.101.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "13.2.0",
    "isbot": "^5.2.2",
    "iso-3166-1": "^2.1.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.2.0",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vitest": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "portless": "0.15.6",
    "@react-router/dev": "^8.4.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "jiti": "^2.7.0",
    "oxfmt": "0.70.0",
    "oxlint": "^1.85.0",
    "pg": "^8.23.0",
    "playwright": "^1.61.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "portless": {
    "name": "labs",
    "script": "dev:app"
  }
}
