    "@react-router/node": "^8.2.0",
    "@react-router/serve": "^8.2.0",
    "@tanstack/ai": "^0.22.1",
    "@tanstack/ai-openrouter": "^0.9.8",
    "@tanstack/react-query": "^5.101.3",
