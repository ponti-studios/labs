    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "engines": {
