{
  "name": "@ponti-studios/labs-workspace",
  "private": true,
  "scripts": {
    "db:generate": "pnpm --filter @pontistudios/db db:generate",
    "db:migrate": "pnpm --filter @pontistudios/db db:migrate",
    "build:labs": "pnpm --filter @pontistudios/labyrinth build",
    "build:all": "pnpm run build:labs && pnpm run build:what",
    "build": "pnpm run build:labs",
    "lint:check": "pnpm --filter @pontistudios/labyrinth lint:check",
    "test": "pnpm --filter @pontistudios/labyrinth test",
    "test:shared": "pnpm --filter @pontistudios/ai test",
    "test:labs-game": "pnpm --filter @pontistudios/labyrinth test:what",
    "typecheck:labs": "pnpm --filter @pontistudios/labyrinth typecheck",
    "typecheck:shared": "pnpm --filter @pontistudios/ai typecheck && pnpm --filter @pontistudios/db typecheck && pnpm --filter @pontistudios/env typecheck",
    "typecheck": "pnpm --filter @pontistudios/labyrinth exec react-router typegen && pnpm --filter what exec react-router typegen && tsc -b tsconfig.json",
    "build:what": "pnpm --filter what build",
    "test:game": "pnpm --filter what test",
    "typecheck:game": "pnpm --filter what typecheck",
    "labs:dev": "pnpm --filter @pontistudios/labyrinth dev",
    "game:dev": "pnpm --filter what dev",
    "game:generate": "pnpm --filter what game:generate",
    "game:health-check": "pnpm --filter what game:health-check",
    "game:ingest": "pnpm --filter what game:ingest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "portless": "0.15.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.10.0"
}
