{
  "name": "@pontistudios/labyrinth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "react-router dev",
    "lint": "oxlint app --fix",
    "format": "oxfmt app --write",
    "search:seed": "JITI_TSCONFIG_PATHS=1 jiti scripts/load-search-corpus.ts",
    "search:sync": "JITI_TSCONFIG_PATHS=1 jiti scripts/load-search-corpus.ts --mode sync",
    "realitea:health-check": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-health-check.ts",
    "realitea:ingest": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-ingest.ts",
    "realitea:preview": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-preview.ts",
    "realitea:generate": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-generate.ts",
    "realitea:seed-history": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-seed-history.ts",
    "realitea:seed-dev": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-seed-dev.ts",
    "realitea:gallery:screenshot": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-gallery.ts --mode screenshot",
    "realitea:gallery:solve": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-gallery.ts --mode solve",
    "realitea:tile-states": "JITI_TSCONFIG_PATHS=1 jiti scripts/realitea-tile-states.ts",
    "start": "react-router-serve ./build/server/index.js --port=${PORT:-3000}",
    "test": "DEBUG_PRINT_LIMIT=500 vitest run --environment jsdom --coverage --reporter verbose --passWithNoTests",
    "test:realitea": "DEBUG_PRINT_LIMIT=500 vitest run --config vitest.realitea.config.ts --reporter verbose",
    "storybook": "storybook dev -p 6007",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@openrouter/sdk": "^1.2.6",
    "@ponti-studios/auth": "^0.1.1",
    "@ponti-studios/ui": "1.3.0",
    "@react-router/node": "^8.2.0",
    "@react-router/serve": "^8.2.0",
    "@tanstack/ai": "0.44.0",
    "@tanstack/ai-openrouter": "0.16.1",
    "@tanstack/react-query": "^5.101.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/three": "^0.185.1",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "13.1.0",
    "isbot": "^5",
    "iso-3166-1": "^2.1.1",
    "lucide-react": "^1.24.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8.2.0",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.63.0",
    "oxlint": "^1.74.0",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
