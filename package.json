    "@types/three": "^0.185.1",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.42.2",
    "isbot": "^5",
    "iso-3166-1": "^2.1.1",
    "lucide-react": "^1.24.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
