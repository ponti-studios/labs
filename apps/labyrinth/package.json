{
  "name": "@pontistudios/labyrinth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "oxlint app --fix",
    "format": "oxfmt app --write",
    "search:seed": "tsx --tsconfig tsconfig.json scripts/load-search-corpus.ts",
    "search:sync": "tsx --tsconfig tsconfig.json scripts/load-search-corpus.ts --mode sync",
    "realitea:health-check": "tsx --tsconfig tsconfig.json scripts/realitea-health-check.ts",
    "realitea:preview": "tsx --tsconfig tsconfig.json scripts/realitea-preview.ts",
    "realitea:generate": "tsx --tsconfig tsconfig.json scripts/realitea.generate.ts",
    "gallery:realitea:screenshot": "tsx --tsconfig tsconfig.json scripts/gallery-realitea.ts --mode screenshot",
    "gallery:realitea:solve": "tsx --tsconfig tsconfig.json scripts/gallery-realitea.ts --mode solve",
    "start": "react-router-serve ./build/server/index.js --port=${PORT:-3000}",
    "test": "vitest run --environment jsdom --coverage --reporter verbose --passWithNoTests",
    "test:realitea": "vitest run --config vitest.realitea.config.ts --reporter verbose",
    "storybook": "storybook dev -p 6007",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@openrouter/sdk": "^0.12.35",
    "@ponti-studios/ui": "workspace:*",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@tanstack/ai": "^0.22.1",
    "@tanstack/ai-openrouter": "^0.9.8",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/three": "^0.185.1",
    "class-variance-authority": "^0.7.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "catalog:shared",
    "isbot": "catalog:shared",
    "iso-3166-1": "^2.1.1",
    "lucide-react": "catalog:",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pontistudios/tsconfig": "workspace:*",
    "@react-router/dev": "catalog:",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/addon-themes": "10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.65.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "jsdom": "catalog:",
    "pg": "^8.22.0",
    "playwright": "catalog:",
    "storybook": "^10.5.3",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:"
  },
  "packageManager": "pnpm@10.30.3"
}
