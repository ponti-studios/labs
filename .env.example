# Requires the `foundation` sibling repo running (see README.md → Getting Started):
#   git clone https://github.com/ponti-studios/foundation.git ../foundation
#   cd ../foundation && just docker-up
#
# Foundation provides:
#   - PostgreSQL (dev)  on localhost:5434, database `hominem`
#   - PostgreSQL (test) on localhost:4433, database `labs-test`
#   - Redis             on localhost:6379
# Credentials: postgres / postgres

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/hominem"
REDIS_URL="redis://localhost:6379"

VITE_API_URL="http://localhost:4040"

# Services
VITE_GOOGLE_API_KEY=""
